// Queseir Hospital Blood Bank schema.
//
// Phase 1: Hospital, Area, Better Auth tables, StaffMembership, AuditLog.
// Phase 2: Donor, ConsentRecord, DonorVerification, EligibilityRecord, DonorNote,
//          RegistrationAttempt.
// BloodRequest, DonorMatch, Communication and Donation arrive in their own phases
// (docs/mvp-technical-spec.md §15), because several of their enums depend on open
// questions (O1, M2).
//
// Conventions:
// - Domain tables use UUID primary keys; Better Auth tables use its string ids.
// - Table names are snake_case via @@map; columns keep Prisma's camelCase.
// - CHECK constraints, partial indexes and triggers live in hand-edited migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy ──────────────────────────────────────────────────────────────────

model Hospital {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  city      String
  timezone  String   @default("Africa/Cairo")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  areas       Area[]
  memberships StaffMembership[]
  auditLogs   AuditLog[]
  donors      Donor[]

  @@map("hospital")
}

// Hospital-managed locality list (spec D6). The real list for Quseir is open question O5.
model Area {
  id         String   @id @default(uuid()) @db.Uuid
  hospitalId String   @db.Uuid
  city       String
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  donors   Donor[]

  @@unique([hospitalId, city, name])
  // Target of the donor composite FK, so a donor's area always belongs to its hospital.
  @@unique([id, hospitalId])
  @@map("area")
}

// ─── Staff access ─────────────────────────────────────────────────────────────

enum StaffRole {
  ADMIN
  STAFF
  VIEWER
}

// The application role lives here, per hospital (spec D8). Better Auth's own
// `user.role` is kept to "admin" | "user" and only gates its admin endpoints.
model StaffMembership {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String
  hospitalId String    @db.Uuid
  role       StaffRole
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@unique([userId, hospitalId])
  @@index([hospitalId])
  @@map("staff_membership")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

enum AuditActorType {
  STAFF
  PUBLIC
  SYSTEM
}

// Append-only: UPDATE, DELETE and TRUNCATE are blocked by a trigger (see migration).
// `metadata` holds ids, changed field names and status values only — never names,
// phone numbers or free-text notes (spec §8 Audit strategy).
model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  hospitalId  String         @db.Uuid
  actorType   AuditActorType
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  actor    User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([hospitalId, createdAt])
  @@index([hospitalId, entityType, entityId, createdAt])
  @@map("audit_log")
}

// ─── Donors (Phase 2) ─────────────────────────────────────────────────────────

// "Unknown" blood group is NULL, never a value (spec §4).
enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EligibilityStatus {
  UNASSESSED
  ELIGIBLE
  TEMPORARILY_INELIGIBLE
  PERMANENTLY_INELIGIBLE
}

enum ActivityStatus {
  ACTIVE
  INACTIVE
}

enum InactiveReason {
  DONOR_OPT_OUT
  UNREACHABLE
  CONSENT_WITHDRAWN
  DUPLICATE
}

enum Availability {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
}

enum DonatedBefore {
  YES
  NO
  UNSURE
}

enum ContactMethod {
  PHONE
  WHATSAPP
}

enum DonorSource {
  PUBLIC_FORM
  STAFF_ENTRY
}

// Identity, contact and current statuses. The three status axes are independent (spec D2).
model Donor {
  id                            String             @id @default(uuid()) @db.Uuid
  hospitalId                    String             @db.Uuid
  fullName                      String
  phoneE164                     String
  dateOfBirth                   DateTime           @db.Date
  city                          String
  areaId                        String?            @db.Uuid
  preferredContact              ContactMethod
  selfReportedBloodGroup        BloodGroup?
  // Set only by blood-group verification, which is disabled until M6 is approved.
  verifiedBloodGroup            BloodGroup?
  verificationStatus            VerificationStatus @default(PENDING)
  eligibilityStatus             EligibilityStatus  @default(UNASSESSED)
  ineligibleUntil               DateTime?          @db.Date
  // Derived from an approved donation-interval rule (M4); stays NULL until then.
  nextEligibleOn                DateTime?          @db.Date
  activityStatus                ActivityStatus     @default(ACTIVE)
  inactiveReason                InactiveReason?
  availability                  Availability       @default(UNKNOWN)
  unavailableUntil              DateTime?          @db.Date
  donatedBefore                 DonatedBefore
  selfReportedLastDonationMonth DateTime?          @db.Date
  source                        DonorSource
  needsReview                   Boolean            @default(false)
  anonymisedAt                  DateTime?          @db.Timestamptz(3)
  createdAt                     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime           @updatedAt @db.Timestamptz(3)

  hospital      Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  area          Area?               @relation(fields: [areaId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
  consents      ConsentRecord[]
  verifications DonorVerification[]
  eligibility   EligibilityRecord[]
  notes         DonorNote[]

  @@unique([hospitalId, phoneE164])
  // Target of the child tables' composite FKs, so children share the donor's hospital.
  @@unique([id, hospitalId])
  @@index([hospitalId, verificationStatus])
  @@index([hospitalId, eligibilityStatus, activityStatus])
  @@index([hospitalId, verifiedBloodGroup])
  @@index([hospitalId, areaId])
  @@map("donor")
}

enum ConsentPurpose {
  REGISTRY
  CONTACT
}

enum ConsentChannel {
  PUBLIC_FORM
  STAFF_ENTRY
}

// Evidence of each consent (spec D13). Rows are never deleted; withdrawal sets
// withdrawnAt exactly once (trigger). One active consent per (donor, purpose).
model ConsentRecord {
  id            String         @id @default(uuid()) @db.Uuid
  hospitalId    String         @db.Uuid
  donorId       String         @db.Uuid
  purpose       ConsentPurpose
  noticeVersion String
  noticeSha256  String
  channel       ConsentChannel
  capturedById  String?
  grantedAt     DateTime       @default(now()) @db.Timestamptz(3)
  withdrawnAt   DateTime?      @db.Timestamptz(3)
  withdrawnById String?

  donor       Donor @relation(fields: [donorId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
  capturedBy  User? @relation("ConsentCapturedBy", fields: [capturedById], references: [id], onDelete: Restrict)
  withdrawnBy User? @relation("ConsentWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)

  @@index([donorId])
  @@map("consent_record")
}

enum VerificationDecision {
  VERIFIED
  REJECTED
  REVOKED
  REOPENED
}

enum RejectionReason {
  DUPLICATE
  UNREACHABLE
  INVALID
  NOT_MEETING_CRITERIA
  OTHER
}

// Append-only verification decisions (trigger). Blood-group confirmation columns
// are added once the approved verification methods are known (M6).
model DonorVerification {
  id              String               @id @default(uuid()) @db.Uuid
  hospitalId      String               @db.Uuid
  donorId         String               @db.Uuid
  decision        VerificationDecision
  rejectionReason RejectionReason?
  note            String               @default("")
  decidedById     String
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)

  donor     Donor @relation(fields: [donorId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
  decidedBy User  @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([donorId, createdAt])
  @@map("donor_verification")
}

// Append-only eligibility assessments (trigger). reasonCategory is added once the
// deferral categories are approved (M7).
model EligibilityRecord {
  id             String            @id @default(uuid()) @db.Uuid
  hospitalId     String            @db.Uuid
  donorId        String            @db.Uuid
  status         EligibilityStatus
  until          DateTime?         @db.Date
  note           String            @default("")
  rulesetVersion String?
  recordedById   String
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)

  donor      Donor @relation(fields: [donorId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
  recordedBy User  @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([donorId, createdAt])
  @@map("eligibility_record")
}

// Staff notes. Visible to ADMIN/STAFF only (donor:note).
model DonorNote {
  id         String   @id @default(uuid()) @db.Uuid
  hospitalId String   @db.Uuid
  donorId    String   @db.Uuid
  authorId   String
  body       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  donor  Donor @relation(fields: [donorId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([donorId, createdAt])
  @@map("donor_note")
}

// Throttle for the public form. Stores a keyed hash of the client IP, never the IP.
// Rows older than the throttle window are deleted on later submissions.
model RegistrationAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  hospitalId String   @db.Uuid
  ipHash     String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([hospitalId, ipHash, createdAt])
  @@index([createdAt])
  @@map("registration_attempt")
}

// ─── Better Auth (core + admin plugin) ────────────────────────────────────────
// Mirrors Better Auth's Prisma schema. After installing, run `npx auth generate`
// and compare; if Better Auth 1.7 differs, adopt its output and add a migration.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime? @db.Timestamptz(3)

  sessions    Session[]
  accounts    Account[]
  memberships StaffMembership[]
  auditLogs   AuditLog[]

  consentsCaptured      ConsentRecord[]     @relation("ConsentCapturedBy")
  consentsWithdrawn     ConsentRecord[]     @relation("ConsentWithdrawnBy")
  verificationDecisions DonorVerification[]
  eligibilityRecords    EligibilityRecord[]
  donorNotes            DonorNote[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}
