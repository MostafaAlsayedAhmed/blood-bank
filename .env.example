# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://bloodbank:bloodbank@localhost:5432/bloodbank"
# Optional: an empty database used by `pnpm db:check-drift`.
SHADOW_DATABASE_URL="postgresql://bloodbank:bloodbank@localhost:5432/bloodbank_shadow"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the app (used for cookies and trusted origins).
BETTER_AUTH_URL="http://localhost:3000"

# Development seed only. Password given to the three fictional staff accounts (min 12 chars).
# The seed refuses to run when NODE_ENV=production.
SEED_STAFF_PASSWORD=""
